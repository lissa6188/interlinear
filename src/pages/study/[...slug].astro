---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { readingMinutes } from '../../lib/notes';
import { SITE } from '../../lib/site';
import { graph, person, PERSON_ID, SITE_ID } from '../../lib/jsonld';

export async function getStaticPaths() {
  const studies = await getCollection('study');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

interface Props {
  study: CollectionEntry<'study'>;
}

const { study } = Astro.props;
const { Content } = await render(study);

const body = study.body ?? '';

// 스터디 글은 캡처 화면이 본체다. 캡처 없는 글은 배포로 나가지 못하게 막는다.
// 초안을 쓰는 동안(개발 서버)은 경고만 하고, 빌드에서는 실패시킨다.
const hasCapture = /!\[[^\]]*\]\([^)]*\)/.test(body) || /<img\b/.test(body);
if (!hasCapture) {
  const message = `[스터디] "${study.id}" 에 캡처 이미지가 없습니다. 스터디 글은 캡처 화면이 있어야 합니다.`;
  if (import.meta.env.PROD) throw new Error(message);
  console.warn(message);
}

const isoDate = study.data.date.toISOString().slice(0, 10);
const shortDate = isoDate.slice(2).replace(/-/g, '.');
const minutes = readingMinutes(body);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const markdownUrl = `${SITE.url}/study/${study.id}.md`;
const updatedIso = study.data.updated?.toISOString().slice(0, 10) ?? isoDate;

const jsonLd = graph(
  person(),
  {
    '@type': 'BlogPosting',
    '@id': `${canonical}#post`,
    headline: study.data.title,
    description: study.data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    datePublished: isoDate,
    dateModified: updatedIso,
    keywords: study.data.tags.join(', '),
    articleSection: '스터디',
    timeRequired: `PT${minutes}M`,
    inLanguage: 'ko',
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': SITE_ID },
    encoding: {
      '@type': 'MediaObject',
      encodingFormat: 'text/markdown',
      contentUrl: markdownUrl,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '스터디', item: `${SITE.url}/study/` },
      { '@type': 'ListItem', position: 2, name: study.data.title, item: canonical },
    ],
  }
);
---

<BaseLayout title={study.data.title} description={study.data.description} ogType="article">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} />
  <meta slot="head" property="article:published_time" content={isoDate} />
  <meta slot="head" property="article:modified_time" content={updatedIso} />

  <main class="wrap" id="main">
    <article class="sheet-study">
      <header class="article-head">
        <div class="article-meta mono">
          <time datetime={isoDate}>{shortDate}</time>
          <span class="article-min">{minutes} min</span>
        </div>
        <h1 class="article-t">{study.data.title}</h1>
        <p class="article-d">{study.data.description}</p>
        <TagList tags={study.data.tags} class="article-tags" />
      </header>

      {study.data.video && <VideoEmbed src={study.data.video} title={`${study.data.title} 영상`} />}

      <div class="prose">
        <Content />
      </div>

      <footer class="article-foot mono">
        <a href="/study/">&larr; 스터디 목록</a>
        <a
          class="foot-end"
          href={`mailto:${SITE.email}?subject=${encodeURIComponent(study.data.title)}`}
        >
          이 글로 문의하기
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>

<script>
  // @ts-nocheck — 의도적으로 순수 자바스크립트다.
  // 캡처는 높이를 맞추느라 실제 크기보다 작게 보인다. 눌렀을 때 원본 크기로
  // 볼 수 있게 하되, 읽던 페이지가 가려지거나 넘어가지 않도록 별도 창으로 띄운다.
  const captures = Array.from(document.querySelectorAll('.prose img'));

  captures.forEach((img) => {
    img.title = '클릭하면 새 창에서 원본 크기로 봅니다';
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const img = event.target.closest('.prose img');
    if (!img) return;
    event.preventDefault();

    const src = img.currentSrc || img.src;
    // 원본 크기에 맞춘 창. 화면보다 크면 화면에 맞춘다
    const width = Math.min(img.naturalWidth || 1200, window.screen.availWidth - 80);
    const height = Math.min(img.naturalHeight || 800, window.screen.availHeight - 140);

    // 창 이름을 고정해 두면 다음 캡처를 눌러도 창이 계속 늘어나지 않는다
    const opened = window.open(
      src,
      'interlinear-capture',
      `width=${width},height=${height},resizable=yes,scrollbars=yes`
    );

    // 팝업이 막혔으면 새 탭으로. 어느 쪽이든 읽던 페이지는 그대로 남는다
    if (!opened) window.open(src, '_blank', 'noopener');
  });
</script>
