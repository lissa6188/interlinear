---
import { SITE } from '../lib/site';

interface Props {
  hints: string[];
}

const { hints } = Astro.props;
---

<section class="hero">
  <div class="hero-in">
    <p class="hero-lede">{SITE.lede}</p>
    <div class="searchbox">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        class="search"
        id="q"
        type="search"
        placeholder="무엇을 찾으세요?"
        aria-label="노트 검색"
        aria-controls="grid"
        autocomplete="off"
      />
      <button class="search-clear" id="clear" type="button" aria-label="검색어 지우기">
        지우기 ✕
      </button>
    </div>
    {
      hints.length > 0 && (
        <div class="hero-hints">
          <span class="hint-label">바로가기</span>
          {hints.map((tag) => (
            <a class="hint" href={`/?q=${encodeURIComponent(tag)}`} data-tag={tag}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
