---
interface Props {
  tags: readonly string[];
  class?: string;
}

// 태그는 링크다. 글 상세 페이지처럼 검색 스크립트가 없는 곳에서도
// 눌러서 필터된 목록(/?q=태그)으로 갈 수 있어야 하기 때문이다.
// 목록 페이지에서는 스크립트가 클릭을 가로채 이동 없이 필터만 한다.
const { tags, class: className = 'card-tags' } = Astro.props;
---

{
  tags.length > 0 && (
    <div class={className}>
      {tags.map((tag) => (
        <a class="tag" href={`/?q=${encodeURIComponent(tag)}`} data-tag={tag}>
          {tag}
        </a>
      ))}
    </div>
  )
}
